rules_version = '2';

// Security rules for the hosted web app's shared data.
// Deploy with:  npx firebase-tools deploy --only firestore:rules
//
// Everything lives in one collection, `shared`, one document per app key
// (see src/storage-shared-firebase.js):
//
//   join:<4 digits>             which game a join code points at   written by the host
//   race:<token>                live race snapshot                 written by the host
//   bet:<token>:<raceId>:<id>   one bet                            written by whoever placed it
//
// Every phone signs in anonymously and invisibly. `owner` is the Firebase user
// that last wrote the document, and only they can change it — with two
// exceptions: a join code that's been switched off (or left untouched for
// 12 hours) can be claimed by a new game, and a host can clear the bets
// placed on their own game.
//
// A new bet is only accepted while that race's betting is open: the race
// snapshot (whose JSON always starts {"raceId":…,"status":…) must be for the
// bet's race and say "setup". A stored bet can be sent again unchanged (the
// app retries slow saves with the same id) but never altered. And its text
// must be exactly the shape the app writes (betValue() in the app): its own
// id, a name of 1–40 characters, an optional phone id, a racer, a plain
// positive amount, and win or place.
service cloud.firestore {
  match /databases/{database}/documents {

    match /shared/{docId} {

      function signedIn() {
        return request.auth != null;
      }

      function isJoin(id) {
        return id.matches('^join:[0-9]{4}$');
      }
      function isRace(id) {
        return id.matches('^race:[A-Za-z0-9]{1,40}$');
      }
      function isBet(id) {
        return id.matches('^bet:[A-Za-z0-9]{1,40}:[A-Za-z0-9]{1,40}:[A-Za-z0-9]{1,40}$');
      }

      // The race document that a bet's key points at.
      function raceOf(id) {
        return /databases/$(database)/documents/shared/$('race:' + id.split(':')[1]);
      }

      function validShape() {
        let d = request.resource.data;
        // expiresAt (optional: older copies of the app don't send it) is
        // when a time-to-live policy may delete the document.
        return d.keys().hasOnly(['key', 'value', 'owner', 'updatedAt', 'expiresAt'])
          && d.keys().hasAll(['key', 'value', 'owner', 'updatedAt'])
          && (!('expiresAt' in d) || d.expiresAt is timestamp)
          && d.key == docId
          && d.value is string
          && d.value.size() < 50000
          && d.owner == request.auth.uid
          && d.updatedAt == request.time;
      }

      function ownsIt() {
        return resource.data.owner == request.auth.uid;
      }

      // A bet's stored JSON, exactly as the app writes it. (bettorId and
      // betType are optional for bets from older copies of the app.)
      function validBet(id) {
        return request.resource.data.value.matches(
          '[{]"id":"' + id.split(':')[3] + '"'
          + ',"bettorName":"([^"\\\\]|\\\\.){1,40}"'
          + '(,"bettorId":"[A-Za-z0-9]{1,40}")?'
          + ',"racerId":"[A-Za-z0-9]{1,40}"'
          + ',"amount":[0-9]{1,5}([.][0-9]{1,6})?'
          + '(,"betType":"(win|place)")?[}]'
        );
      }

      // The bet's race is the one in the snapshot, and its betting is open.
      // Anchored to the start of the JSON, so text inside names can't fake it.
      function bettingOpenFor(id) {
        return get(raceOf(id)).data.value.matches(
          '[{]"raceId":"' + id.split(':')[2] + '","status":"setup"[,}].*'
        );
      }

      // A join code another game can take over: switched off, or abandoned.
      function joinIsFree() {
        return resource.data.value.matches('.*"active":false.*')
          || request.time > resource.data.updatedAt + duration.value(12, 'h');
      }

      // Anyone at the table (any signed-in phone) can read: the data is a race
      // and some bets, and the doc IDs include random tokens.
      allow read: if signedIn();

      allow create: if signedIn() && validShape()
        && (isJoin(docId)
            || isRace(docId)
            || (isBet(docId) && validBet(docId) && exists(raceOf(docId)) && bettingOpenFor(docId)));

      allow update: if signedIn() && validShape()
        && ((isJoin(docId) && (ownsIt() || joinIsFree()))
            || (isRace(docId) && ownsIt())
            || (isBet(docId) && ownsIt() && request.resource.data.value == resource.data.value));

      allow delete: if signedIn()
        && (ownsIt()
            || (isBet(docId)
                && exists(raceOf(docId))
                && get(raceOf(docId)).data.owner == request.auth.uid));
    }

    // Nothing else exists; deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
