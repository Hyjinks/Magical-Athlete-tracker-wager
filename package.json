{
  "name": "magical-athlete-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Race tracker, betting and draft companion for the Magical Athlete board game.",
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js,.jsx,.mjs magical-athlete-tracker.jsx src scripts tests",
    "dev": "vite",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:web": "vite build",
    "build": "npm run build:artifact && npm run build:web",
    "preview": "vite preview",
    "test": "node tests/smoke.mjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "1.56.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
